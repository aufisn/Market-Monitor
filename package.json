{
  "name": "market-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "US stock price & volume threshold alerts on a Cloudflare Worker with Telegram acknowledgment",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "npm run check:repo && npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy-freeze.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.45.0"
  }
}
